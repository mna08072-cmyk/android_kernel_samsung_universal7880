+#else
+/* 3.18: no get_link slot (follow_link/put_link era). Virtual symlinks
+ * (init assigns nm_file_iops to every non-dir, incl. S_ISLNK) delegate to
+ * the real inode's link ops so fonts.xml-style symlinks resolve. */
+static void *nm_follow_link_318(struct dentry *dentry, struct nameidata *nd)
+{
+    struct inode *inode = dentry ? d_backing_inode(dentry) : NULL;
+    struct nm_inode_info *info = inode ? inode->i_private : NULL;
+    struct inode *real_inode;
+    struct dentry *real_dentry;
+    if (unlikely(!info || !info->rule || !info->rule->r_path.dentry))
+        return ERR_PTR(-ECHILD);
+    real_dentry = info->rule->r_path.dentry;
+    real_inode = d_backing_inode(real_dentry);
+    if (real_inode && real_inode->i_op && real_inode->i_op->follow_link)
+        return real_inode->i_op->follow_link(real_dentry, nd);
+    return ERR_PTR(-EINVAL);
+}
+
+static void nm_put_link_318(struct dentry *dentry, struct nameidata *nd, void *cookie)
+{
+    struct inode *inode = dentry ? d_backing_inode(dentry) : NULL;
+    struct nm_inode_info *info = inode ? inode->i_private : NULL;
+    struct inode *real_inode;
+    struct dentry *real_dentry;
+    if (unlikely(!info || !info->rule || !info->rule->r_path.dentry))
+        return;
+    real_dentry = info->rule->r_path.dentry;
+    real_inode = d_backing_inode(real_dentry);
+    /* ext4 fast symlinks have no put_link: NULL is a valid no-op. */
+    if (real_inode && real_inode->i_op && real_inode->i_op->put_link)
+        real_inode->i_op->put_link(real_dentry, nd, cookie);
+}
+
+static int nm_readlink_318(struct dentry *dentry, char __user *buffer, int buflen)
+{
+    struct inode *inode = dentry ? d_backing_inode(dentry) : NULL;
+    struct nm_inode_info *info = inode ? inode->i_private : NULL;
+    struct inode *real_inode;
+    struct dentry *real_dentry;
+    if (unlikely(!info || !info->rule || !info->rule->r_path.dentry))
+        return -ECHILD;
+    real_dentry = info->rule->r_path.dentry;
+    real_inode = d_backing_inode(real_dentry);
+    if (real_inode && real_inode->i_op && real_inode->i_op->readlink)
+        return real_inode->i_op->readlink(real_dentry, buffer, buflen);
+    return -EINVAL;
+}
 #endif
 
