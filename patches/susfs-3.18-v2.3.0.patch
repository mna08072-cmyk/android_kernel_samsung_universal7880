 	return 0;
 }
 
diff --git a/kernel/reboot.c b/kernel/reboot.c
index d5f7d3eee15..f07be0016bc 100644
--- a/kernel/reboot.c
+++ b/kernel/reboot.c
@@ -299,6 +299,19 @@ SYSCALL_DEFINE4(reboot, int, magic1, int, magic2, unsigned int, cmd,
 	if (!ns_capable(pid_ns->user_ns, CAP_SYS_BOOT))
 		return -EPERM;
 
